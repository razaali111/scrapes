# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# eCass login (per branch — Boulevard shown; rotate if exposed)
ECASS_USER=Boulevardpharmacy@outlook.com
ECASS_PASS=

# Supabase (optional). Set both to upsert straight into public.ecass_offers.
# Use the SERVICE ROLE key — it bypasses RLS. Local machine only; never commit.
# Leave blank to write JSONL only (output/ecass_offers_*.jsonl).
SUPABASE_URL=https://fprafvakzrwxspxfrgpc.supabase.co
SUPABASE_SERVICE_KEY=

# Throughput knobs (from a residential IP you can raise these).
ECASS_CONCURRENCY=6
ECASS_DELAY=0.15
ECASS_LOG_LEVEL=INFO

# Optional — Zyte Smart Proxy (only if running on Zyte Scrapy Cloud, to get
# residential IPs past the datacenter block). Paid Zyte add-on.
ZYTE_SMARTPROXY_ENABLED=false
ZYTE_SMARTPROXY_APIKEY=
